   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A tent city has been set up by UNHCR, the United Nations High Commission for Refugees, for 300 families which amounts to 1,600 people.  Up to 10,000 people will arrive at the tent city soon due to the on-coming winter,  Bessian, Kashmir, Pakistan, Saturday, 22 October 2005</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>UN Photo/Evan Schneider</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Earthquake</rdf:li>
    </rdf:Alt>
   </dc:title>
   <photoshop:SupplementalCategories>
    <rdf:Bag>
     <rdf:li>Y</rdf:li>
    </rdf:Bag>
   </photoshop:SupplementalCategories>
  </rdf:Description>
